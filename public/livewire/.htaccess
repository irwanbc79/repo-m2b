<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    Header always unset X-LiteSpeed-Cache
</IfModule>

<IfModule LiteSpeed>
    CacheDisable on
    RewriteRule .* - [E=noabort:1]
    RewriteRule .* - [E=noconntimeout:1]
</IfModule>

# FIX (2026-06-08): subdir .htaccess dgn RewriteEngine On mematikan pewarisan
# rewrite front-controller dari parent. Sebelumnya hanya 'update' yg di-route ke
# index.php, sehingga /livewire/upload-file & /livewire/preview-file -> 404
# (gejala: "The payment_proof failed to upload" saat upload bukti bayar).
# Solusi: route SEMUA path non-file di /livewire/ ke /index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=no-cache:1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ /index.php [L]
</IfModule>
